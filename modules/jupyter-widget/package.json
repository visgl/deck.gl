{
  "name": "@deck.gl/jupyter-widget",
  "description": "Jupyter widget for rendering deck.gl in a Jupyter notebook",
  "license": "MIT",
  "version": "9.4.0-beta.4",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "anywidget",
    "widgets",
    "geospatial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl.git"
  },
  "bugs": {
    "url": "https://github.com/visgl/deck.gl/issues"
  },
  "homepage": "https://deck.gl",
  "main": "dist/index.js",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/widget.js",
    "dist/widget.js.map",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "watch": "npm run build:standalone -- --watch",
    "build": "npm run build:standalone && npm run build:widget",
    "build:standalone": "ocular-bundle ./src/index.js --output=./dist/index.js --globalName= --sourcemap --format=umd",
    "build:widget": "node ./scripts/build-widget.mjs",
    "build:dev": "npm run build:standalone -- --env=dev && node ./scripts/build-widget.mjs --env=dev",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "9.4.0-beta.4",
    "@deck.gl/core": "9.4.0-beta.4",
    "@deck.gl/extensions": "9.4.0-beta.4",
    "@deck.gl/geo-layers": "9.4.0-beta.4",
    "@deck.gl/google-maps": "9.4.0-beta.4",
    "@deck.gl/json": "9.4.0-beta.4",
    "@deck.gl/layers": "9.4.0-beta.4",
    "@deck.gl/mapbox": "9.4.0-beta.4",
    "@deck.gl/maplibre": "9.4.0-beta.4",
    "@deck.gl/mesh-layers": "9.4.0-beta.4",
    "@deck.gl/widgets": "9.4.0-beta.4",
    "@loaders.gl/3d-tiles": "^4.4.3",
    "@loaders.gl/core": "^4.4.3",
    "@loaders.gl/csv": "^4.4.3",
    "@luma.gl/core": "^9.4.0",
    "@luma.gl/effects": "^9.4.0",
    "@luma.gl/webgl": "^9.4.0",
    "d3-dsv": "^1.0.8",
    "mapbox-gl": "^1.13.2",
    "maplibre-gl": "^5.14.0"
  },
  "gitHead": "13ace64fc2cee08c133afc882fc307253489a4e4"
}
