{
  "name": "@deck.gl/maplibre",
  "description": "Use deck.gl layers with MapLibre GL JS",
  "license": "MIT",
  "type": "module",
  "version": "10.0.0-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "webgl",
    "visualization",
    "maplibre",
    "overlay"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl.git"
  },
  "bugs": {
    "url": "https://github.com/visgl/deck.gl/issues"
  },
  "homepage": "https://deck.gl",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "dependencies": {
    "@math.gl/core": "5.0.0-beta.8"
  },
  "peerDependencies": {
    "@deck.gl/core": "~10.0.0-alpha",
    "@luma.gl/core": "10.0.0-alpha.14",
    "maplibre-gl": "^4.5.1 || ^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "maplibre-gl": "^6.3.0",
    "maplibre-gl-v4": "npm:maplibre-gl@4.5.1",
    "maplibre-gl-v5": "npm:maplibre-gl@5.0.0",
    "maplibre-gl-v6": "npm:maplibre-gl@6.0.0"
  }
}
