{
  "name": "@deck.gl/core",
  "description": "deck.gl core library",
  "license": "MIT",
  "type": "module",
  "version": "9.4.0-beta.4",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "webgl",
    "visualization",
    "overlay",
    "layer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl.git"
  },
  "bugs": {
    "url": "https://github.com/visgl/deck.gl/issues"
  },
  "homepage": "https://deck.gl",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "visgl:webgl-only": {
        "import": "./dist.webgl-only/index.js",
        "require": "./dist.webgl-only/index.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./arrow": {
      "types": "./dist/lib/luma-upstream/arrow-converter.d.ts",
      "visgl:webgl-only": {
        "import": "./dist.webgl-only/lib/luma-upstream/arrow-converter.js",
        "require": "./dist.webgl-only/lib/luma-upstream/arrow-converter.cjs"
      },
      "import": "./dist/lib/luma-upstream/arrow-converter.js",
      "require": "./dist/lib/luma-upstream/arrow-converter.cjs"
    }
  },
  "files": [
    "dist",
    "dist.webgl-only",
    "src",
    "debug.min.js",
    "dist.min.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build-debugger": "ocular-bundle ./bundle/debug.ts --output=./debug.min.js --globalName=deck.debug",
    "build-bundle": "ocular-bundle ./bundle/index.ts",
    "prepublishOnly": "npm run build-debugger && npm run build-bundle && npm run build-bundle -- --env=dev"
  },
  "dependencies": {
    "@loaders.gl/core": "5.0.0-beta.1",
    "@loaders.gl/images": "5.0.0-beta.1",
    "@luma.gl/core": "10.0.0-alpha.6",
    "@luma.gl/engine": "10.0.0-alpha.6",
    "@luma.gl/gpgpu": "10.0.0-alpha.6",
    "@luma.gl/shaders": "10.0.0-alpha.6",
    "@math.gl/core": "5.0.0-beta.1",
    "@math.gl/earth": "5.0.0-beta.1",
    "@math.gl/geospatial": "5.0.0-beta.1",
    "@math.gl/web-mercator": "5.0.0-beta.1",
    "@probe.gl/env": "^4.1.1",
    "@probe.gl/log": "^4.1.1",
    "@probe.gl/stats": "^4.1.1",
    "@types/offscreencanvas": "^2019.6.4",
    "gl-matrix": "^3.0.0",
    "mjolnir.js": "^3.1.1"
  },
  "gitHead": "13ace64fc2cee08c133afc882fc307253489a4e4",
  "peerDependencies": {
    "apache-arrow": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "apache-arrow": {
      "optional": true
    }
  }
}
