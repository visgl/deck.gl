{
  "name": "@deck.gl/geo-layers",
  "description": "deck.gl layers supporting geospatial use cases and GIS formats",
  "license": "MIT",
  "type": "module",
  "version": "9.4.0-beta.4",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "webgl",
    "visualization",
    "geospatial",
    "layer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl.git"
  },
  "bugs": {
    "url": "https://github.com/visgl/deck.gl/issues"
  },
  "homepage": "https://deck.gl",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "visgl:webgl-only": {
        "import": "./dist.webgl-only/index.js",
        "require": "./dist.webgl-only/index.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "dist.webgl-only",
    "src",
    "dist.min.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build-bundle": "ocular-bundle ./bundle.ts",
    "prepublishOnly": "npm run build-bundle && npm run build-bundle -- --env=dev"
  },
  "dependencies": {
    "@loaders.gl/3d-tiles": "^5.0.0-alpha.7",
    "@loaders.gl/gis": "^5.0.0-alpha.7",
    "@loaders.gl/loader-utils": "^5.0.0-alpha.7",
    "@loaders.gl/mvt": "^5.0.0-alpha.7",
    "@loaders.gl/schema": "^5.0.0-alpha.7",
    "@loaders.gl/terrain": "^5.0.0-alpha.7",
    "@loaders.gl/tiles": "^5.0.0-alpha.7",
    "@loaders.gl/wms": "^5.0.0-alpha.7",
    "@luma.gl/gltf": "^10.0.0-alpha.2",
    "@luma.gl/shadertools": "^10.0.0-alpha.2",
    "@math.gl/core": "^5.0.0-alpha.9",
    "@math.gl/culling": "^5.0.0-alpha.9",
    "@math.gl/web-mercator": "^5.0.0-alpha.9",
    "@types/geojson": "^7946.0.8",
    "a5-js": "^0.10.0",
    "h3-js": "^4.4.0",
    "long": "^3.2.0"
  },
  "peerDependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/mesh-layers": "~9.4.0",
    "@loaders.gl/core": "^5.0.0-alpha.7",
    "@luma.gl/core": "~10.0.0-alpha.2",
    "@luma.gl/engine": "~10.0.0-alpha.2"
  },
  "gitHead": "13ace64fc2cee08c133afc882fc307253489a4e4"
}
