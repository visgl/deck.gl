var __rspack_ns_object = JSON.parse('{"id":"developer-guide/projection-domains","title":"Projection domains and worker preprocessing","description":"Applications written against math.gl\'s projection interfaces can use external projection engines through a CRS descriptor adapter. That adapter converts coordinates; it does not supply geometry clipping, antimeridian topology or triangulation. Applications that need those operations can preprocess geometry with the external engine and render the result in deck.gl\'s Cartesian coordinate system.","source":"@site/../docs/developer-guide/projection-domains.md","sourceDirName":"developer-guide","slug":"/developer-guide/projection-domains","permalink":"/next/docs/developer-guide/projection-domains","draft":false,"unlisted":false,"editUrl":"https://github.com/visgl/deck.gl/tree/master/website/../docs/developer-guide/projection-domains.md","tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"Coordinate Systems","permalink":"/next/docs/developer-guide/coordinate-systems"},"next":{"title":"Views and Projections","permalink":"/next/docs/developer-guide/views"}}')