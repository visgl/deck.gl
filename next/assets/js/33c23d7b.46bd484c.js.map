var __rspack_ns_object = JSON.parse('{"id":"developer-guide/coordinate-systems","title":"Coordinate Systems","description":"In most deck.gl layers, every data object is expected to contain one or more positions (e.g. the center of a point, or the start and end of an arc, the vertices of a polygon, etc). Positions are expected to be supplied as two or three element arrays ([x, y] or [x, y, z]). Objects can also have dimensions (e.g. the radius of a circle, the width of a path, etc), most of which are specified as a single number. Positions and dimensions are used to construct a 3D world with your data.","source":"@site/../docs/developer-guide/coordinate-systems.md","sourceDirName":"developer-guide","slug":"/developer-guide/coordinate-systems","permalink":"/next/docs/developer-guide/coordinate-systems","draft":false,"unlisted":false,"editUrl":"https://github.com/visgl/deck.gl/tree/master/website/../docs/developer-guide/coordinate-systems.md","tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"Interactivity","permalink":"/next/docs/developer-guide/interactivity"},"next":{"title":"Views and Projections","permalink":"/next/docs/developer-guide/views"}}')