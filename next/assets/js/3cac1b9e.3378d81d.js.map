var __rspack_ns_object = JSON.parse('{"id":"api-reference/core/custom-projection-view","title":"CustomProjectionView (Experimental)","description":"CustomProjectionView renders a planar map in a target CRS resolved by @math.gl/geospatial/projection. Input positions and camera centers use WGS84 longitude/latitude in degrees and altitude in meters. It supports planar projections, with altitude and extruded geometry, using CustomProjectionViewport and CustomProjectionController.","source":"@site/../docs/api-reference/core/custom-projection-view.md","sourceDirName":"api-reference/core","slug":"/api-reference/core/custom-projection-view","permalink":"/next/docs/api-reference/core/custom-projection-view","draft":false,"unlisted":false,"editUrl":"https://github.com/visgl/deck.gl/tree/master/website/../docs/api-reference/core/custom-projection-view.md","tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"GlobeView","permalink":"/next/docs/api-reference/core/globe-view"},"next":{"title":"FirstPersonView","permalink":"/next/docs/api-reference/core/first-person-view"}}')