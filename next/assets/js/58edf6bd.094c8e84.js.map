var __rspack_ns_object = JSON.parse('{"id":"api-reference/proposals/tileset-2d","title":"Tileset2D","description":"Tileset2D manages tile loading and caching for both the new Tile2DLayer and the compatibility TileLayer. One instance can serve multiple layers and views. It owns tile headers, content, scheduling, cache eviction, TileSource metadata, stats, and subscriptions. New layers keep independent selection and visibility state per view.","source":"@site/../docs/api-reference/proposals/tileset-2d.md","sourceDirName":"api-reference/proposals","slug":"/api-reference/proposals/tileset-2d","permalink":"/next/docs/api-reference/proposals/tileset-2d","draft":false,"unlisted":false,"editUrl":"https://github.com/visgl/deck.gl/tree/master/website/../docs/api-reference/proposals/tileset-2d.md","tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"MVT2DLayer","permalink":"/next/docs/api-reference/proposals/mvt-2d-layer"},"next":{"title":"Tile2DHeader","permalink":"/next/docs/api-reference/proposals/tile-2d-header"}}')