var __rspack_ns_object = JSON.parse('{"id":"api-reference/extensions/collision-filter-extension","title":"CollisionFilterExtension","description":"The CollisionFilterExtension allows layers to hide features which overlap with other features. An example is a dense ScatterplotLayer with many points which overlap: by using this extension points that collide with others are hidden such that only one of the colliding points is shown. The collisions are computed on the GPU in realtime, allowing the collisions to be updated smoothly on every frame.","source":"@site/../docs/api-reference/extensions/collision-filter-extension.md","sourceDirName":"api-reference/extensions","slug":"/api-reference/extensions/collision-filter-extension","permalink":"/next/docs/api-reference/extensions/collision-filter-extension","draft":false,"unlisted":false,"editUrl":"https://github.com/visgl/deck.gl/tree/master/website/../docs/api-reference/extensions/collision-filter-extension.md","tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"ClipExtension","permalink":"/next/docs/api-reference/extensions/clip-extension"},"next":{"title":"DataFilterExtension","permalink":"/next/docs/api-reference/extensions/data-filter-extension"}}')