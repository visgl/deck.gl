var __rspack_ns_object = JSON.parse('{"id":"developer-guide/base-maps/using-with-3d-tiles","title":"Using with 3D Tiles","description":"deck.gl has excellent support for visualizing 3D Tiles tilesets, such as photogrammetric city models from Google Maps or Cesium ion. This guide explains how to set up an application with Tile3DLayer, use the TerrainController for terrain-aware navigation, and overlay your own data layers on top of the 3D surface.","source":"@site/../docs/developer-guide/base-maps/using-with-3d-tiles.md","sourceDirName":"developer-guide/base-maps","slug":"/developer-guide/base-maps/using-with-3d-tiles","permalink":"/next/docs/developer-guide/base-maps/using-with-3d-tiles","draft":false,"unlisted":false,"editUrl":"https://github.com/visgl/deck.gl/tree/master/website/../docs/developer-guide/base-maps/using-with-3d-tiles.md","tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"WebGPU","permalink":"/next/docs/developer-guide/webgpu"},"next":{"title":"Using with ArcGIS","permalink":"/next/docs/developer-guide/base-maps/using-with-arcgis"}}')