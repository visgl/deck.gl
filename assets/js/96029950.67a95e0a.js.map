var __rspack_ns_object = JSON.parse('{"id":"developer-guide/zoom-dependent-layers","title":"Zoom-Dependent Layers","description":"Map styles often change what is drawn as the camera zooms: coarse summaries at low zoom give way to finer ones, labels thin out, lines keep a readable width. The MapLibre and Mapbox style specs express this declaratively with layer minzoom/maxzoom and [\\"zoom\\"] expressions. The two specs share the syntax used on this page.","source":"@site/../docs/developer-guide/zoom-dependent-layers.md","sourceDirName":"developer-guide","slug":"/developer-guide/zoom-dependent-layers","permalink":"/docs/developer-guide/zoom-dependent-layers","draft":false,"unlisted":false,"editUrl":"https://github.com/visgl/deck.gl/tree/master/website/../docs/developer-guide/zoom-dependent-layers.md","tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"Animations and Transitions","permalink":"/docs/developer-guide/animations-and-transitions"},"next":{"title":"Loading Data","permalink":"/docs/developer-guide/loading-data"}}')