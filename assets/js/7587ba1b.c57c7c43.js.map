var __rspack_ns_object = JSON.parse('{"id":"developer-guide/custom-widgets/README","title":"Writing Your Own Widget","description":"Widgets are UI components that are deeply integrated with deck.gl\'s views and layers. A widget can be positioned relative to a view, react to viewport and layer changes, respond to picking events, and drive the view state. The @deck.gl/widgets module ships many ready-made widgets, and this guide covers how to write your own when none of them fit.","source":"@site/../docs/developer-guide/custom-widgets/README.md","sourceDirName":"developer-guide/custom-widgets","slug":"/developer-guide/custom-widgets/","permalink":"/docs/developer-guide/custom-widgets/","draft":false,"unlisted":false,"editUrl":"https://github.com/visgl/deck.gl/tree/master/website/../docs/developer-guide/custom-widgets/README.md","tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"Writing Shaders","permalink":"/docs/developer-guide/custom-layers/writing-shaders"},"next":{"title":"Universal Widgets","permalink":"/docs/developer-guide/custom-widgets/universal-widgets"}}')